[importlinter]
root_package = evolvets
include_external_packages = False

[importlinter:contract:sealed-isolation]
name = Agent-editable packages never reach sealed or live data
type = forbidden
source_modules =
    evolvets.updater
    evolvets.improver
    evolvets.selfmodel
    evolvets.allocator
forbidden_modules =
    evolvets.arena.sealed
    evolvets.arena.live

[importlinter:contract:ground-truth-isolation]
name = Agent-editable packages never reach targets, oracles or raw forecasts
type = forbidden
source_modules =
    evolvets.updater
    evolvets.improver
    evolvets.selfmodel
    evolvets.allocator
forbidden_modules =
    evolvets.arena.synthetic
    evolvets.arena.realdata
    evolvets.cache

[importlinter:contract:updater-isolation]
name = Updaters see data only through the replay loop
type = forbidden
source_modules =
    evolvets.updater
forbidden_modules =
    evolvets.arena
    evolvets.experts
    evolvets.ledger
    evolvets.runner
